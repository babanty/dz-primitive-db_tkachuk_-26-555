[276.158859, "o", "\u001b[A\u001b[C\u001b[Cdatabase\r\n\r\u001b[A"]
[276.15897, "o", "\r\n\u001b[?2004l\r"]
[276.187679, "o", "\r\n***База данных***\r\n\r\nУправление таблицами:\r\n  create_table <таблица> <столбец:тип> ... - создать таблицу\r\n  list_tables - показать таблицы\r\n  drop_table <таблица> - удалить таблицу\r\n  info <таблица> - информация о таблице\r\n\r\nОперации с данными:\r\n  insert into <таблица> values (<значение>, ...)\r\n  select from <таблица>\r\n  select from <таблица> where <столбец> = <значение>\r\n  update <таблица> set <столбец> = <значение> where <столбец> = <значение>\r\n  delete from <таблица> where <столбец> = <значение>\r\n\r\nВ update можно указать несколько присваиваний через запятую.\r\n\r\nОбщие команды:\r\n  help - справочная информация\r\n  exit - выход\r\n\r\nТипы: int, str, bool. Все поля обязательны.\r\nСтроки пишутся в двойных кавычках. Логические значения: true и false.\r\nID:int добавляется автоматически и недоступен для изменения.\r\n\r\n"]
[276.187937, "o", "Введите команду: "]
[282.457336, "o", "list_tables"]
[282.979086, "o", "\r\n- users\r\nВведите команду: "]
[294.762106, "o", "select from users"]
[295.194591, "o", "\r\n"]
[295.195177, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[295.216945, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 2  | Anna |  31 |   False   |\r\n+----+------+-----+-----------+\r\nВведите команду: "]
[299.840523, "o", "drop_table users"]
[300.380674, "o", "\r\nВы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[304.661503, "o", "y"]
[305.453341, "o", "\r\n"]
[305.453821, "o", "Таблица \"users\" успешно удалена.\r\nВведите команду: "]
[311.325053, "o", "list_tables"]
[312.075242, "o", "\r\nТаблиц пока нет.\r\nВведите команду: "]
