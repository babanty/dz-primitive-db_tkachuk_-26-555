[68.57756, "o", "\u001b[?2004h$ "]
[77.813258, "o", "\u001b[7mDEMO_DIR=\"$(mktemp -d /tmp/primitive-db-demo.XXXXXX)\"\u001b[27m\r\n\r\u001b[7mcd \"$DEMO_DIR\"\u001b[27m\r\n\r"]
[78.432845, "o", "\u001b[A\u001b[A\u001b[C\u001b[CDEMO_DIR=\"$(mktemp -d /tmp/primitive-db-demo.XXXXXX)\"\r\n\rcd \"$DEMO_DIR\"\r\n\r\u001b[A\r\n\u001b[?2004l\r"]
[78.437103, "o", "\u001b[?2004h$ "]
[86.924177, "o", "\u001b[7mdatabase\u001b[27m\r\n\r"]
[88.728404, "o", "\u001b[A\u001b[C\u001b[Cdatabase\r\n"]
[88.728592, "o", "\r\u001b[A\r\n\u001b[?2004l\r"]
[88.79983, "o", "\r\n***База данных***\r\n\r\nУправление таблицами:\r\n  create_table <таблица> <столбец:тип> ... - создать таблицу\r\n  list_tables - показать таблицы\r\n  drop_table <таблица> - удалить таблицу\r\n"]
[88.8002, "o", "  info <таблица> - информация о таблице\r\n\r\nОперации с данными:\r\n  insert into <таблица> values (<значение>, ...)\r\n  select from <таблица>\r\n  select from <таблица> where <столбец> = <значение>\r\n  update <таблица> set <столбец> = <значение> where <столбец> = <значение>\r\n  delete from <таблица> where <столбец> = <значение>\r\n\r\nВ update можно указать несколько присваиваний через запятую.\r\n\r\nОбщие команды:\r\n  help - справочная информация\r\n  exit - выход\r\n\r\nТипы: int, str, bool. Все поля обязательны.\r\nСтроки пишутся в двойных кавычках. Логические значения: true и false.\r\nID:int добавляется автоматически и недоступен для изменения.\r\n\r\nВведите команду: "]
[96.194004, "o", "create_table users name:str age:int is_active:bool"]
[96.831788, "o", "\r\n"]
[96.83258, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\nВведите команду: "]
[105.861388, "o", "list_tables"]
[106.42752, "o", "\r\n- users\r\nВведите команду: "]
