[62.879269, "o", "\r\u001b[2K███████████████░░░░░ [3/4] \u001b[2mwcwidth==0.9.1                                                                                                                 \u001b[0m\r\u001b[2K████████████████████ [4/4] \u001b[2mwcwidth==0.9.1                                                                                                                 \u001b[0m\r\u001b[2K\u001b[2mInstalled \u001b[1m4 packages\u001b[0m \u001b[2min 4ms\u001b[0m\u001b[0m\r\n \u001b[32m+\u001b[39m \u001b[1mprettytable\u001b[0m\u001b[2m==3.18.0\u001b[0m\r\n \u001b[32m+\u001b[39m \u001b[1mprimitive-db\u001b[0m\u001b[2m==1.0.0 (from file:///workspaces/dz-primitive-db_tkachuk_-26-555/dist/primitive_db-1.0.0-py3-none-any.whl)\u001b[0m\r\n \u001b[32m+\u001b[39m \u001b[1mprompt\u001b[0m\u001b[2m==0.4.1\u001b[0m\r\n \u001b[32m+\u001b[39m \u001b[1mwcwidth\u001b[0m\u001b[2m==0.9.1\u001b[0m\r\nInstalled 2 executables: \u001b[1mdatabase\u001b[0m, \u001b[1mproject\u001b[0m\r\n"]
[62.882436, "o", "\u001b[?2004h$ "]
[67.996945, "o", "\u001b[7mexport PATH=\"$(uv tool dir --bin):$PATH\"\u001b[27m\r\n\r"]
[68.567741, "o", "\u001b[A\u001b[C\u001b[Cexport PATH=\"$(uv tool dir --bin):$PATH\"\r\n\r\u001b[A\r\n"]
