[326.811878, "o", "\r\n\r\u001b[A"]
[326.81327, "o", "\r\n\u001b[?2004l\r\r\n=== Демонстрация завершена ===\r\n\u001b[?2004h$ "]
[335.01611, "o", "\u001b[7mexit\u001b[27m\r\n\r"]
